`timescale 1ns/1ps

module chanakyalink_tb;

    reg  [7:0]  slave_id;
    reg  [7:0]  command;
    reg  [15:0] delay_time;
    wire [7:0]  checksum;

    reg  [1:0]  rand_slave;
    reg  [1:0]  rand_cmd;

    reg  slv1_line, slv2_line, slv3_line, slv4_line;

 
    reg  activate_line, deactivate_line, status_check_line;

   
    reg        ai_select_line;
    reg  [7:0] ai_slave_select;

    chanakyalink_design DUT (
        .slave_id  (slave_id),
        .command   (command),
        .delay_time(delay_time),
        .checksum  (checksum)
    );

   

    task show_slave_bus;
        $display("  SLAVE_1           :  %b", slv1_line);
        $display("  SLAVE_2           :  %b", slv2_line);
        $display("  SLAVE_3           :  %b", slv3_line);
        $display("  SLAVE_4           :  %b", slv4_line);
    endtask

  

    task show_command_bus;
        $display("  ACTIVATE_LINE     :  %b", activate_line);
        $display("  DEACTIVATE_LINE   :  %b", deactivate_line);
        $display("  STATUS_CHECK_LINE :  %b", status_check_line);
    endtask

 

    task show_ai_signals;
        $display("  AI_SELECT_LINE    :  %b", ai_select_line);
        $display("  AI_SLAVE_SELECT   :  %b", ai_slave_select);
    endtask

    

    initial begin

        $display("");
        $display("  ================================");
        $display("     CHANAKYALINK  PROTOCOL");
        $display("  ================================");
        $display("");

       

        slv1_line         = 0; slv2_line       = 0;
        slv3_line         = 0; slv4_line       = 0;
        activate_line     = 0; deactivate_line = 0;
        status_check_line = 0;
        ai_select_line    = 0;
        ai_slave_select   = 8'd0;

        $display("  // BUS IDLE");
        show_ai_signals;
        $display("");
        show_slave_bus;
        $display("");
        show_command_bus;
        $display("");

      

        rand_slave = $random % 4;
        rand_cmd   = $random % 3;

        slave_id   = rand_slave + 1;
        command    = rand_cmd   + 1;
        delay_time = 16'd3000;

        #10;

       
        ai_select_line  = 1;
        ai_slave_select = slave_id;

        slv1_line = (slave_id == 1) ? 1 : 0;
        slv2_line = (slave_id == 2) ? 1 : 0;
        slv3_line = (slave_id == 3) ? 1 : 0;
        slv4_line = (slave_id == 4) ? 1 : 0;

      
        activate_line     = (command == 8'd1) ? 1 : 0;
        deactivate_line   = (command == 8'd2) ? 1 : 0;
        status_check_line = (command == 8'd3) ? 1 : 0;

        $display("  // AI SELECTION");
        show_ai_signals;
        $display("");
        show_slave_bus;
        $display("");
        show_command_bus;
        $display("");

        

        #20;

        $display("  // FRAME BITS");
        $display("  START             :  1");
        $display("  SLAVE_ID          :  %b", slave_id);
        if      (command == 8'd1) $display("  COMMAND           :  ACTIVATE");
        else if (command == 8'd2) $display("  COMMAND           :  DEACTIVATE");
        else                      $display("  COMMAND           :  STATUS_CHECK");
        $display("  DELAY             :  %0d ns", delay_time);
        $display("  CHECKSUM          :  %b", checksum);
        $display("  STOP              :  1");
        $display("");

    

        #20;

        // AI select line goes LOW — decision handed to master
        ai_select_line = 0;

        $display("  // TRANSMISSION    Master  ->  Slave %0d", slave_id);
        $display("  AI_SELECT_LINE    :  %b", ai_select_line);
        $display("  DATA_LINE         :  1");
        $display("  ACKNOWLEDGE_LINE  :  0");
        $display("");

      

        #20;

        $display("  // RECEPTION   Slave %0d", slave_id);
        $display("  DATA_LINE         :  0");
        $display("  ACKNOWLEDGE_LINE  :  1");
        $display("");

      

        $display("  // ADDRESS MATCH");
        $display("  FRAME_SLAVE_ID    :  %b", slave_id);
        $display("  NODE_SLAVE_ID     :  %b", slave_id);
        $display("  ADDRESS_MATCH     :  1");
        $display("");

       

        #20;

        $display("  // DELAY EXECUTION");
        $display("  1000 ns elapsed");
        #20;
        $display("  2000 ns elapsed");
        #20;
        $display("  3000 ns elapsed  --  Done");
        $display("  COUNTER_DONE      :  1");
        $display("");

       

        #10;

        $display("  // CHECKSUM VERIFICATION");
        $display("  CALCULATED        :  %b", checksum);
        $display("  RECEIVED          :  %b", checksum);

        if (checksum == (slave_id ^ command ^ delay_time[15:8] ^ delay_time[7:0])) begin

            $display("  CHECKSUM_MATCH    :  1");
            $display("");

          

            #20;

            $display("  // COMMAND EXECUTION   Slave %0d", slave_id);
            if      (command == 8'd1) $display("  COMMAND           :  ACTIVATE");
            else if (command == 8'd2) $display("  COMMAND           :  DEACTIVATE");
            else                      $display("  COMMAND           :  STATUS_CHECK");
            $display("");
            show_command_bus;
            $display("");

            if (command == 8'd1)      $display("  OUTPUT            :  1");
            else if (command == 8'd2) $display("  OUTPUT            :  0");
            else                      $display("  HEALTH_STATUS     :  1");

            $display("");
            $display("  // FINAL BUS STATE");
            show_ai_signals;
            $display("");
            show_slave_bus;
            $display("");
            show_command_bus;

        end else begin

            $display("  CHECKSUM_MATCH    :  0");
            $display("  [ERROR]  Frame Rejected  --  Slave %0d Halted", slave_id);

        end

        $display("");
        $display("  ================================");
        $display("     EXECUTION COMPLETE");
        $display("  ================================");
        $display("");

        #10;
        $finish;

    end

endmodule
